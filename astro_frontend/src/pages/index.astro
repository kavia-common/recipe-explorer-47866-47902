---
import Layout from '../layouts/Layout.astro';
import RecipeGrid from '../components/recipes/RecipeGrid.astro';
import SidebarFilters from '../components/recipes/SidebarFilters.astro';
import SearchBar from '../components/recipes/SearchBar.astro';
import { getAllRecipes } from '../utils/data';
const recipes = getAllRecipes();
---

<Layout title="Recipe Explorer – Home">
  <section class="hero container" aria-labelledby="home-title">
    <div class="hero-content">
      <h1 id="home-title">Discover your next favorite recipe</h1>
      <p class="lead">Search, filter, and explore curated recipes with clear ingredients and steps.</p>
      <SearchBar />
    </div>
  </section>

  <section class="container content-grid">
    <aside class="sidebar" aria-labelledby="filters-title">
      <h2 id="filters-title" class="sr-only">Filters</h2>
      <SidebarFilters />
    </aside>

    <div class="results">
      <RecipeGrid {recipes} />
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding: 28px 20px 8px 20px;
  }
  .hero-content {
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 18px;
    box-shadow: var(--shadow-sm);
    background-image: radial-gradient(1200px 1200px at 0% -10%, rgba(37,99,235,.08), transparent 60%);
  }
  .lead {
    color: var(--text-secondary);
    margin: 6px 0 12px 0;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 20px;
    padding: 18px 0 28px 0;
  }
  .sidebar {
    position: sticky;
    top: 76px;
    align-self: start;
    height: max-content;
  }
  .results {
    min-height: 300px;
  }

  .sr-only {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }
    .sidebar {
      position: static;
      order: -1;
    }
  }
</style>
