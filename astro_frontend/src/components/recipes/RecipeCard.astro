---
import type { Recipe } from '../../utils/data';
const { recipe } = Astro.props as { recipe: Recipe };
---

<article class="card" aria-labelledby={`title-${recipe.id}`}>
  <a class="thumb" href={`/recipes/${recipe.id}`} aria-label={`Open ${recipe.title}`}>
    <img src={recipe.image} alt="" loading="lazy" />
    <div class="badge">{recipe.timeMinutes}m</div>
  </a>
  <div class="body">
    <h3 id={`title-${recipe.id}`} class="title">
      <a href={`/recipes/${recipe.id}`}>{recipe.title}</a>
    </h3>
    <p class="desc">{recipe.description}</p>
    <div class="meta">
      <span class="pill">{recipe.cuisine}</span>
      <span class="pill">{recipe.course}</span>
      <span class="pill">{recipe.difficulty}</span>
    </div>
  </div>
</article>

<style>
  .card {
    display: grid;
    grid-template-rows: auto 1fr;
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform .15s ease, box-shadow .2s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #e5e7eb;
  }
  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: linear-gradient(135deg, var(--color-secondary), #fbbf24);
    color: #111827;
    font-weight: 700;
    border-radius: 999px;
    padding: 4px 8px;
    font-size: .85rem;
    border: 1px solid rgba(0,0,0,.06);
  }
  .body {
    padding: 10px 12px 12px 12px;
  }
  .title {
    margin: 0 0 4px 0;
    font-size: 1.05rem;
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .title a:hover {
    text-decoration: underline;
  }
  .desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: .95rem;
  }
  .meta {
    margin-top: 8px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .pill {
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 2px 8px;
    font-size: .8rem;
    color: var(--text-secondary);
    background: rgba(37,99,235,.06);
  }
</style>
