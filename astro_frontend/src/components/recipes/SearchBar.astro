---
/** SearchBar component with accessible search input. Emits 'recipe:search' CustomEvent with detail { query } */
---

<form class="search" role="search" aria-label="Recipe search" on:submit="return false">
  <label class="sr-only" for="q">Search recipes</label>
  <div class="field">
    <input id="q" name="q" type="search" placeholder="Search recipes, ingredients, or tags..." aria-describedby="search-help" inputmode="search" />
    <button type="button" aria-label="Search" class="btn-search">
      🔍
    </button>
  </div>
  <p id="search-help" class="assistive">Type to filter by title, description, tags, or ingredients.</p>
</form>

<style>
  .search {
    display: grid;
    gap: 8px;
  }
  .field {
    display: flex;
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 8px 8px 8px 12px;
    box-shadow: var(--shadow-sm);
  }
  .field:focus-within {
    box-shadow: var(--ring);
    outline: none;
  }
  input[type="search"] {
    flex: 1;
    font-size: 1rem;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--text-color);
  }
  .btn-search {
    border: 0;
    background: linear-gradient(135deg, rgba(37,99,235,.16), rgba(245,158,11,.14));
    color: var(--text-color);
    border-radius: var(--radius-sm);
    padding: 8px 10px;
    cursor: pointer;
  }
  .assistive {
    color: var(--text-secondary);
    font-size: .9rem;
    margin: 0;
  }
  .sr-only {
    position: absolute !important;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
</style>

<script>
  const input = document.getElementById('q');
  const button = document.querySelector('.btn-search');
  const dispatch = () => {
    const query = input.value.trim();
    document.dispatchEvent(new CustomEvent('recipe:search', { detail: { query } }));
  };
  input?.addEventListener('input', dispatch);
  button?.addEventListener('click', dispatch);
</script>
